# ============================================================
#  VIJAY VARGIYA GROUP OF HOSPITALS - environment configuration
#  copy to .env and edit
# ============================================================

APP_NAME="Vijay Vargiya Group of Hospitals"
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ---------- MySQL (primary) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vijay_vargiya_hospital
DB_USER=vvh_app
DB_PASSWORD=change_me

# Full SQLAlchemy URL. Leaving this blank builds it from DB_* above.
DATABASE_URL=

# ---------- JWT / security ----------
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
PASSWORD_HASH_ITERATIONS=260000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- File storage ----------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---------- WhatsApp (Twilio) ----------
# When disabled, messages are queued in the whatsapp_messages table and the
# console provider logs them (perfect for local development).
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Email (SMTP) ----------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@vijayvargiiyahospital.in

# ---------- AI assistant: Groq only ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_TOKENS=700
SLOT_HOLD_MINUTES=10

# ---------- Background jobs ----------
ENABLE_SCHEDULER=true
